---
/**
 * Iris's pathways and palette with a source-backed three-question introduction.
 * Guide content is selected at sync time; this component only renders navigation.
 */
import { withBase } from '../../namespaces.mjs';
import { NAV_ROUTES } from '../../pathways.mjs';
import GuidedIntro from './GuidedIntro.astro';
import DocsSearch from './DocsSearch.astro';
import GuideReader from './GuideReader.astro';
import '../../styles/explore.css';

const { pathways } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div data-lq-explore class="lq-explore">
<GuidedIntro />
<DocsSearch />

<div class="lq-landing-next">
  <a href={withBase(base, 'start/quickstart')}>Try a fictional document</a>
  <a href={withBase(base, 'start/is-it-for-you')}>Decide whether it fits</a>
  <a href={`${base}llms.txt`}>Docs for agents</a>
</div>

<h2>Find the guide you need</h2>

<nav class="lq-landing-grid" aria-label="Documentation pathways">
  {
    pathways.map((p) => (
      <a class="lq-landing-card" data-tone={p.tone} href={withBase(base, NAV_ROUTES.pathway(p.id))}>
        <strong>{p.title}</strong>
        <span class="lq-landing-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ))
  }
</nav>
<GuideReader />
</div>
<script>
  import '../../scripts/explore';
</script>

<style>
  /* Unlayered on purpose: these render inside .sl-markdown-content, and
     theme.css's unlayered prose rules would beat any layered style. */
  .lq-landing-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px;
  }
  .lq-landing-next { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem; }
  .lq-landing-next a { border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; padding: 0.75rem 1rem; }

  .lq-landing-card {
    grid-column: span 5;
    min-height: 145px;
    padding: 30px 34px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--lq-card-ink);
    text-decoration: none;
    transition:
      transform 180ms ease,
      filter 180ms ease,
      box-shadow 180ms ease;
  }

  .lq-landing-card[data-tone='a'] {
    background: var(--lq-card-a);
  }
  .lq-landing-card[data-tone='b'] {
    background: var(--lq-card-b);
  }
  .lq-landing-card[data-tone='c'] {
    background: var(--lq-card-c);
  }

  .lq-landing-card:nth-child(2),
  .lq-landing-card:nth-child(3) {
    grid-column: span 7;
  }

  .lq-landing-card:nth-child(n + 3) {
    min-height: 145px;
  }

  .lq-landing-card strong {
    max-width: 90%;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .lq-landing-arrow {
    align-self: flex-end;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .lq-landing-card:is(:hover, :focus-visible),
  .lq-landing-card:is(:hover, :focus-visible) * {
    text-decoration: none;
    color: var(--lq-card-ink);
  }

  @media (hover: hover) {
    .lq-landing-card:hover {
      transform: translateY(-4px);
      filter: brightness(1.045);
      box-shadow: 0 12px 24px #0002;
    }

    .lq-landing-card:hover .lq-landing-arrow {
      transform: rotate(45deg);
    }
  }

  .lq-landing-card:focus-visible {
    outline: 3px solid var(--lq-accent);
    outline-offset: 4px;
  }

  @media (max-width: 50rem) {
    .lq-landing-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .lq-landing-card,
    .lq-landing-card:nth-child(n) {
      grid-column: 1;
      min-height: 108px;
      padding: 22px;
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }

    .lq-landing-card strong {
      font-size: 1.75rem;
    }

    .lq-landing-arrow {
      align-self: center;
      flex-shrink: 0;
      width: 40px;
      height: 40px;
    }
  }
</style>
