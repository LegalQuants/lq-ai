---
/**
 * Header for the pathways layout (Iris's UI review, lq-docs-v2).
 *
 * One grid: the LQ.AI wordmark, search, and three icon buttons on the first
 * row; the four pathway tabs on the second. On the landing page the tabs are
 * left out — the landing's cards are the same four links, larger.
 *
 *   - All documentation — a link to the sitemap page (`/all/`).
 *   - Dark mode — a toggle button. It writes Starlight's own theme key, so the
 *     choice survives a reload exactly as the classic theme select's does.
 *   - Reduced motion — a toggle button that overrides the system setting and
 *     remembers the choice (`lq-motion`; applied before paint by routeData).
 *
 * Each button has a fixed accessible name and states its setting with
 * `aria-pressed`; the tooltip repeats the name for sighted mouse and keyboard
 * users and is hidden from assistive technology so the name is not read twice.
 * Buttons are 44×44 px (WCAG 2.5.5).
 *
 * Search stays Starlight's Pagefind: a static index on this origin, so a query
 * never leaves the site.
 */
import Search from 'virtual:starlight/components/Search';
import config from 'virtual:starlight/user-config';

import { withBase } from '../../namespaces.mjs';
import { NAV_ROUTES, PATHWAYS, pathwayOf } from '../../pathways.mjs';

const { id, siteTitleHref } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
const route = String(id ?? '').replace(/\/+$/, '');
const current = pathwayOf(route);
const isLanding = route === NAV_ROUTES.landing;
const isAll = route === NAV_ROUTES.all;

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="lq-pw-header">
  <a class="lq-pw-brand" href={siteTitleHref} translate="no">LQ.AI</a>

  <div class="lq-pw-search print:hidden">{shouldRenderSearch && <Search />}</div>

  <div class="lq-pw-actions print:hidden">
    <a
      class="lq-pw-chip"
      href={withBase(base, NAV_ROUTES.all)}
      aria-label="All documentation"
      aria-current={isAll ? 'page' : undefined}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="4" y="4" width="6.5" height="6.5" rx="1.5"></rect>
        <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"></rect>
        <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"></rect>
        <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"></rect>
      </svg>
      <span class="lq-pw-tip" aria-hidden="true">All documentation</span>
    </a>
    <button class="lq-pw-chip" type="button" data-lq-toggle="theme" aria-label="Dark mode" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
      </svg>
      <span class="lq-pw-tip" aria-hidden="true">Dark mode</span>
    </button>
    <button class="lq-pw-chip" type="button" data-lq-toggle="motion" aria-label="Reduced motion" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M8 5.5v13l10.5-6.5Z"></path>
      </svg>
      <span class="lq-pw-tip" aria-hidden="true">Reduced motion</span>
    </button>
  </div>

  {
    !isLanding && (
      <nav class="lq-pw-tabs print:hidden" aria-label="Documentation pathways">
        <ul>
          {PATHWAYS.map((p) => {
            const href = withBase(base, NAV_ROUTES.pathway(p.id));
            const onHub = route === NAV_ROUTES.pathway(p.id);
            const inside = current?.id === p.id;
            return (
              <li>
                <a
                  href={href}
                  data-tone={p.tone}
                  aria-current={onHub ? 'page' : inside ? 'true' : undefined}
                >
                  {p.title}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</div>

<script>
  const root = document.documentElement;

  function sync() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-lq-toggle]')) {
      const on =
        button.dataset.lqToggle === 'theme'
          ? root.dataset.theme === 'dark'
          : root.dataset.motion === 'reduced';
      button.setAttribute('aria-pressed', String(on));
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-lq-toggle]')) {
    button.addEventListener('click', () => {
      try {
        if (button.dataset.lqToggle === 'theme') {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          localStorage.setItem('starlight-theme', next);
        } else {
          const next = root.dataset.motion === 'reduced' ? 'full' : 'reduced';
          root.dataset.motion = next;
          localStorage.setItem('lq-motion', next);
        }
      } catch {
        // Storage can be blocked; the toggle still works for this page view.
      }
      sync();
    });
  }
  sync();
</script>

<style>
  /* Unlayered on purpose: these render inside .sl-markdown-content, and
     theme.css's unlayered prose rules would beat any layered style. */
  .lq-pw-header {
    display: grid;
    grid-template-columns: auto minmax(10rem, 32.5rem) auto;
    grid-template-areas:
      'brand search actions'
      'tabs tabs tabs';
    grid-template-rows: var(--lq-nav-row) var(--lq-tabs-row);
    align-items: center;
    justify-content: space-between;
    column-gap: 1.5rem;
    height: 100%;
  }

  .lq-pw-brand {
    grid-area: brand;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  .lq-pw-search {
    grid-area: search;
    min-width: 0;
  }

  .lq-pw-actions {
    grid-area: actions;
    display: flex;
    gap: 0.5rem;
    justify-self: end;
  }

  .lq-pw-chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .lq-pw-chip svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .lq-pw-chip:hover {
    background: var(--lq-color-hover);
  }

  /* "All documentation" is the filled chip, in the page's accent. */
  a.lq-pw-chip {
    background: var(--sl-color-bg-accent);
    border-color: var(--sl-color-bg-accent);
    color: var(--sl-color-text-invert);
  }

  a.lq-pw-chip:hover {
    filter: brightness(1.08);
  }

  .lq-pw-chip[aria-pressed='true'] {
    border-color: var(--sl-color-bg-accent);
    background: var(--lq-color-hover);
    color: var(--sl-color-text-accent);
  }

  .lq-pw-tip {
    position: absolute;
    top: calc(100% + 9px);
    right: 0;
    width: max-content;
    max-width: 16rem;
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    background: var(--sl-color-white);
    color: var(--sl-color-bg);
    font-size: 0.8125rem;
    line-height: 1.3;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 100;
  }

  .lq-pw-chip:is(:hover, :focus-visible) .lq-pw-tip {
    opacity: 1;
    visibility: visible;
  }

  .lq-pw-tabs {
    grid-area: tabs;
    align-self: stretch;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lq-pw-tabs ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lq-pw-tabs a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 6px;
    font-size: 1rem;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .lq-pw-tabs a:hover {
    background: var(--lq-color-hover);
  }

  /* The current pathway's tab is filled in that pathway's own tone. */
  .lq-pw-tabs a[aria-current] {
    background: var(--sl-color-bg-accent);
    color: var(--sl-color-text-invert);
    font-weight: 600;
  }

  @media (max-width: 50rem) {
    .lq-pw-header {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'brand actions'
        'search search'
        'tabs tabs';
      /* 3.75 + 3.5 = --lq-nav-row on phones (theme-pathways.css) */
      grid-template-rows: 3.75rem 3.5rem var(--lq-tabs-row);
      align-content: start;
    }

    .lq-pw-actions {
      gap: 0.375rem;
    }

    .lq-pw-tabs {
      padding-top: 0.5rem;
    }

    .lq-pw-tabs ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem;
      width: 100%;
    }

    .lq-pw-tabs a {
      padding: 0.4rem 0.55rem;
      font-size: 0.875rem;
    }
  }
</style>
