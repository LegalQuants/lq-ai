<dialog class="lq-guide-reader" data-lq-reader aria-labelledby="lq-reader-title">
  <header class="lq-reader-toolbar">
    <h2 id="lq-reader-title">Documentation</h2>
    <div class="lq-reader-actions">
      <!-- Search never disappears while reading: this closes the reader and
           puts the cursor in the composer, as ⌘K does. -->
      <button type="button" class="lq-reader-search" data-lq-reader-search>Search</button>
      <button type="button" class="lq-reader-close" data-lq-reader-close aria-label="Close documentation">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
  </header>
  <nav class="lq-reader-links" aria-label="Guide reading options">
    <a data-lq-full-guide data-no-reader href="#">Open full guide</a>
    <a data-lq-guide-markdown data-no-reader href="#">Read as Markdown</a>
  </nav>
  <div class="lq-reader-scroll" data-lq-reader-scroll tabindex="-1" role="region" aria-label="Guide content">
    <p data-lq-reader-status role="status" aria-live="polite"></p>
    <div data-lq-reader-meta></div>
    <div class="sl-markdown-content" data-lq-reader-body></div>
    <div data-lq-reader-sources></div>
  </div>
</dialog>
