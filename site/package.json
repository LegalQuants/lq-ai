{
  "name": "lq-ai-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LQ.AI public documentation site (Astro Starlight, ADR 0028).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "npm run sync && npm run diagrams && astro dev",
    "build": "npm run sync && npm run diagrams && astro build && node scripts/postbuild-machine-surface.mjs && node scripts/gen-guide-details.mjs",
    "preview": "astro preview",
    "test": "node --test test/*.test.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:tables": "node scripts/check-tables.mjs",
    "check:a11y": "node scripts/a11y.mjs",
    "check:a11y:review": "PA11Y_INCLUDE_WARNINGS=1 node scripts/a11y.mjs",
    "check:contrast": "node scripts/theme-contrast.mjs",
    "check:docs-links": "python3 ../docs/audits/check_doc_links.py $(find ../docs/site -name README.md -prune -o \\( -name '*.md' -o -name '*.mdx' \\) -print) $(node scripts/list-manifest-sources.mjs)",
    "check:single-source": "node scripts/check-single-source.mjs",
    "check": "npm test && npm run check:single-source && npm run build && npm run check:links && npm run check:orphans && npm run check:tables && npm run check:contrast && npm run check:a11y && npm run check:docs-links",
    "astro": "astro",
    "diagrams": "node scripts/render-diagrams.mjs",
    "check:explore": "node scripts/check-explore.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:e2e": "node --test --test-concurrency=1 e2e/*.e2e.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "gray-matter": "4.0.3",
    "mermaid": "12.2.0",
    "pa11y-ci": "5.0.0",
    "yaml": "2.9.1"
  }
}
