# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Development image — extends the production base with dev extras
# (pytest, respx, pytest-cov, etc.) so the test suite runs in-container.
#
# Usage:
#   docker build -f api/Dockerfile.dev -t lq-ai-api-dev api/
#   docker run --rm lq-ai-api-dev python -m pytest tests/ -x
#
# Or via docker compose override (see docs/dev-compose-override.example.yml):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up api
#
# Production image (api/Dockerfile) installs only runtime deps from the
# lockfile to keep the surface area small.  This dev image adds [dev] extras
# on top of the same base so the two images stay byte-compatible at the
# application layer.

# Digest-pinned for reproducible builds (#301). Bump the tag and digest together.
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS base

# ADR 0023 — same locked install as the production image; see api/Dockerfile.
COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Install runtime + dev deps from the lockfile in a single uv invocation.
# The [dev] extra adds pytest, pytest-asyncio, respx, ruff, mypy, etc.
# (see pyproject.toml [project.optional-dependencies]).
COPY pyproject.toml README.md uv.lock ./
RUN uv sync --frozen --no-install-project --extra dev

# Put the locked venv first on PATH so pytest below resolves to the synced
# environment.
ENV PATH="/app/.venv/bin:$PATH"

# Copy application code and migration files
COPY app/ ./app/
COPY alembic.ini ./alembic.ini
COPY alembic/ ./alembic/
COPY tests/ ./tests/

EXPOSE 8000

# Default entrypoint runs the test suite; override for interactive use.
CMD ["python", "-m", "pytest", "tests/", "-x", "--tb=short"]
