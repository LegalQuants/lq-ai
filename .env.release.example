# LQ.AI — environment for the pre-built image stack (docker-compose.release.yml)
# =============================================================================
#
# This is the .env for the IMAGE-ONLY release stack (no checkout, no build).
# Copy it to `.env` next to docker-compose.release.yml, fill in the four
# required secrets, then:
#
#   docker compose -f docker-compose.release.yml up -d
#
# (The build-from-source dev stack uses the separate `.env.example`.)
#
# The macOS launcher renders its own env at runtime and overrides the ports
# below — these defaults are for a HUMAN running the stack by hand. They are
# SHIFTED away from the dev stack's defaults so the two coexist on one host.
# When running both, also pass `-p lq-ai-release` to every compose command.


# -----------------------------------------------------------------------------
# Image selection
# -----------------------------------------------------------------------------
# Which published tag to run. Pin to a released version (e.g. v0.4.0) for
# reproducibility; `latest` follows the newest published images.
LQ_AI_IMAGE_TAG=latest
# GHCR namespace. Leave as legalquants for the official images; override only
# if you run a fork/mirror that publishes lq-ai-{api,gateway,web} elsewhere.
LQ_AI_IMAGE_NAMESPACE=legalquants


# -----------------------------------------------------------------------------
# REQUIRED secrets — the stack will NOT start until these are set.
# Generate strong random values; do not reuse across deployments.
# -----------------------------------------------------------------------------
# Shared secret the backend uses to authenticate to the Inference Gateway
# (and the gateway back to the backend). Generate with: openssl rand -hex 32
LQ_AI_GATEWAY_KEY=

# Signing secret for JWT access/refresh tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Postgres superuser password for the bundled database.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# MinIO (S3-compatible object store) root password.
# Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# Provider API keys — OPTIONAL.
# Leave blank and add in-app via Configure (BYOK) after first launch; keys are
# hot-applied with no restart. The stack boots fully healthy with NONE set.
# Chat requires at least one provider key before first use.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE=
# Google Vertex (optional) — path to a credentials JSON mounted into the gateway
GOOGLE_APPLICATION_CREDENTIALS=


# -----------------------------------------------------------------------------
# Host ports — SHIFTED defaults so this stack coexists with the dev stack.
# These are SUGGESTIONS for running by hand; the launcher sets its own. All
# ports bind to 127.0.0.1 (loopback only) by default.
# Dev-stack defaults for reference: web 3000, api 8000, gateway 8001,
# postgres 5432, redis 6379, minio 9000/9001.
# These suggestions also avoid the Donna launcher's range (13002 / 18000-18001
# / 25432 / 26379 / 29000-29001) so an LQ.AI hand-run stack, the dev stack, and
# a Donna launcher can all share one host. Change any that clash on your box.
# -----------------------------------------------------------------------------
WEB_HOST_PORT=13012
API_HOST_PORT=18020
GATEWAY_HOST_PORT=18021
POSTGRES_HOST_PORT=25442
REDIS_HOST_PORT=26389
MINIO_API_HOST_PORT=29020
MINIO_CONSOLE_HOST_PORT=29021


# -----------------------------------------------------------------------------
# Optional overrides (sensible defaults baked into the compose file)
# -----------------------------------------------------------------------------
# POSTGRES_DB=lq_ai
# POSTGRES_USER=lq_ai
# MINIO_ROOT_USER=lq_ai
# LOG_LEVEL=info
# Bind to all interfaces instead of loopback (NOT recommended without a proxy):
# WEB_BIND_ADDR=0.0.0.0
